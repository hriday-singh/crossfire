GEMINI_API_KEY=
# Search is powered by SerpApi with automatic fallback to DuckDuckGo Lite via Scrapling
SERPAPI_API_KEY=
# TAVILY_API_KEY= (deprecated)
DEMO_MODE=false

# which provider backs the pipeline: gemini | anthropic | openai_compat
LLM_PROVIDER=openai_compat
# override key for whichever LLM_PROVIDER you picked above (skips that
# provider's own *_API_KEY var) — handy for swapping keys per dev machine
LLM_API_KEY=
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=gemini-3.7-flash
CURATION_LLM_MODEL=gemini-3.7-flash
PORT=8000

# API keys are normally entered in the web UI (Settings -> Providers) and stored
# encrypted in SQLite, not here. The vars below only seed the store when it is
# empty, which is handy on a fresh machine.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Comma-separated Gemini keys. Several keys are sharded across concurrently by
# backend/providers/pool.py, which is what makes free-tier rate limits survivable.
# GEMINI_API_KEYS=key1,key2,key3
# Concurrent in-flight requests per key.
KEY_POOL_MAX_INFLIGHT=2

# Fernet master key encrypting stored API keys. Leave blank and one is generated
# at backend/.crossfire_key on first use; set it explicitly to share a database
# between machines. Generate with:
#   python -c "from providers.keyring import generate_master_key; print(generate_master_key())"
# CROSSFIRE_SECRET_KEY=


# Fan-out control for the evaluator panel. A full panel over 5 claims is ~20
# concurrent LLM calls; cap them and bound each one so a hung connection can't
# hold the SSE stream open.
# One evaluator costs up to 2 x LLM_TIMEOUT_SECONDS + ~1 s sleep (openai_compat
# retries a transient failure once) while holding one EVALUATOR_CONCURRENCY slot.
# With LLM_TIMEOUT_SECONDS=15, one retry pair costs ~31 s — EVALUATOR_TIMEOUT_SECONDS
# at 35 s covers that with a small margin so hung connections fail fast.
EVALUATOR_CONCURRENCY=8
EVALUATOR_TIMEOUT_SECONDS=35
LLM_TIMEOUT_SECONDS=15

# Retrieval budget. Identical queries are coalesced and cached for
# SEARCH_CACHE_TTL_SECONDS; SEARCH_CONCURRENCY caps how many requests leave the
# process at once, so a 20-evaluator fan-out arrives at DuckDuckGo as a queue
# rather than a burst it answers with an empty page.
SEARCH_TIMEOUT_SECONDS=8
SEARCH_CONCURRENCY=4
SEARCH_CACHE_TTL_SECONDS=300
