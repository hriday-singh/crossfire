GEMINI_API_KEY=
# Search uses Scrapling (DuckDuckGo Lite) by default with 0 API keys / credit cards required.
# TAVILY_API_KEY= (deprecated)
DEMO_MODE=false

# which provider backs the pipeline: gemini | anthropic | openai_compat
LLM_PROVIDER=openai_compat
# override key for whichever LLM_PROVIDER you picked above (skips that
# provider's own *_API_KEY var) — handy for swapping keys per dev machine
LLM_API_KEY=
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=gemini-3.7-flash
CURATION_LLM_MODEL=gemini-3.7-flash

# added later, not now:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

